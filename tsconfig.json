{
  "extends": "$app/tsconfig",
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "strict": true,
    "sourceMap": true,
    // Vite resolves `#lib/*` from the `imports` field in package.json.
    // TypeScript does not substitute extensions through an imports map, so it
    // needs the same mapping spelled out here.
    "paths": {
      "#lib/*": ["./src/lib/*"]
    }
  }
}
