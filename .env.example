# ─────────────────────────────────────────────────────────────
# PUBLIC (shipped to the browser)
# ─────────────────────────────────────────────────────────────
PUBLIC_NEAR_NETWORK=mainnet

# Leave empty to use FastNEAR (free.rpc.fastnear.com / test.rpc.fastnear.com).
# Whatever you set must send CORS headers — the browser reads contract state
# directly, and rpc.mainnet.near.org refuses cross-origin requests.
PUBLIC_NEAR_RPC_URL=

# Contracts
# v2 of the pet contract (contracts/game). The old game.joyv1.near is not
# NEP-171 and has none of the methods the other two contracts call.
PUBLIC_CONTRACT_GAME=game-v2.joyv1.near
PUBLIC_CONTRACT_STAKE=stake.joyv1.near
PUBLIC_CONTRACT_MINT_ROUTER=mint.joyv1.near
PUBLIC_TREASURY_ACCOUNT=treasury.joyv1.near

# Multichain mint: price of one pet, denominated in wNEAR (human units)
PUBLIC_MINT_PRICE_WNEAR=2

# NEAR per AI credit, matching mint-router::near_per_credit
PUBLIC_NEAR_PER_CREDIT=0.5

# ─────────────────────────────────────────────────────────────
# PRIVATE (server only — never exposed to the browser)
# ─────────────────────────────────────────────────────────────

# NEAR Intents 1Click API key (a JWT).
# Get it from https://partners.near-intents.org/home
#
# The portal issues more than one kind of key and they are not
# interchangeable. Decode the token's payload and check `key_type`:
#   "distribution_channel" → this is the one; it authenticates 1Click quotes
#   "partner"              → older name for the same thing, also accepted
#   "explorer"             → reads swap history from explorer.near-intents.org,
#                            and does nothing for quoting. Leave this empty.
#
# A key of the wrong type is treated as no key at all, and the server logs a
# warning, so the UI never claims quotes are authenticated when they are not.
#
# Without a key, quotes still work but carry an extra 0.25% fee.
ONECLICK_JWT=

# Optional: override the 1Click base URL
ONECLICK_BASE_URL=https://1click.chaindefuser.com

# Distribution-channel identifier sent with every quote (lowercase).
ONECLICK_REFERRAL=joygotchi

# Optional app fee taken on every swap, in basis points (100 = 1%),
# paid to ONECLICK_FEE_RECIPIENT (an account inside NEAR Intents).
ONECLICK_FEE_BPS=0
ONECLICK_FEE_RECIPIENT=

# Replay guard for AI payment receipts.
#
# Each `spend_credits` transaction hash may buy exactly one inference. Enforcing
# that needs storage shared by every serverless instance, so without KV the
# /api/ai/chat endpoint refuses to run in production.
#
# Vercel KV sets both of these for you when the store is linked to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set to "true" to run without KV anyway, accepting that one payment can buy
# more than one inference. Only sensible for a throwaway deployment.
ALLOW_INSECURE_REPLAY_GUARD=false

# NEAR AI Cloud (https://cloud.near.ai) — OpenAI-compatible gateway.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8

# The feed-XP oracle.
#
# A feed's XP is only known after the inference has run, so the backend signs
# `pet-stake::award_feed_xp` itself. Without these two, feeding still works and
# still costs credits — but the XP is only reported to the browser and never
# written to the pet, which is what the response's `xpAwarded: false` means.
#
# NEAR_ORACLE_ACCOUNT_ID must match the staking contract's `oracle`; read it
# back with `get_config`.
NEAR_ORACLE_ACCOUNT_ID=

# A *function-call* access key limited to `award_feed_xp` on the staking
# contract, as `ed25519:<base58>` (the 64-byte secret key, not the public one).
# Never a full-access key: the chain is what enforces the limit, so a leak of
# this key can award capped XP and nothing else. See contracts/README.md,
# "The feed-XP oracle", for how to make one.
NEAR_ORACLE_PRIVATE_KEY=
