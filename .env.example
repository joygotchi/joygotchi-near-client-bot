# ─────────────────────────────────────────────────────────────
# PUBLIC (shipped to the browser)
# ─────────────────────────────────────────────────────────────
PUBLIC_NEAR_NETWORK=mainnet
PUBLIC_NEAR_RPC_URL=https://rpc.mainnet.near.org

# Game + token contracts
PUBLIC_CONTRACT_GAME=game.joyv1.near
PUBLIC_CONTRACT_FT=faucet.joyv1.near
PUBLIC_CONTRACT_JOY=joy.joyv1.near
PUBLIC_CONTRACT_STAKE=stake.joyv1.near
PUBLIC_CONTRACT_MINT_ROUTER=mint.joyv1.near
PUBLIC_TREASURY_ACCOUNT=treasury.joyv1.near

# Multichain mint: price of one pet, denominated in wNEAR (human units)
PUBLIC_MINT_PRICE_WNEAR=2

# Telegram Mini App ids (used by the HOT wallet in-Telegram flow)
PUBLIC_TG_BOT_ID=joygotchi_bot/game
PUBLIC_TG_WALLET_ID=herewalletbot/app

# ─────────────────────────────────────────────────────────────
# PRIVATE (server only — never exposed to the browser)
# ─────────────────────────────────────────────────────────────

# NEAR Intents 1Click partner JWT.
# Get it from https://partners.near-intents.org/home
# Without it, quotes still work but carry an extra 0.25% unauthenticated fee.
ONECLICK_JWT=

# Optional: override the 1Click base URL
ONECLICK_BASE_URL=https://1click.chaindefuser.com

# Distribution-channel identifier sent with every quote (lowercase).
ONECLICK_REFERRAL=joygotchi

# Optional app fee taken on every swap, in basis points (100 = 1%),
# paid to ONECLICK_FEE_RECIPIENT (an account inside NEAR Intents).
ONECLICK_FEE_BPS=0
ONECLICK_FEE_RECIPIENT=

# NEAR AI Cloud (https://cloud.near.ai) — OpenAI-compatible gateway.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
